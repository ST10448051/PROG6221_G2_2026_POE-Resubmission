<Window x:Class="CyberSecurityAwarenessBot.GUI.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberSecurity Awareness Assistant"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E293B">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🛡 CyberSecurity Awareness Assistant"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <UniformGrid Grid.Row="1"
                     Columns="2"
                     Rows="2"
                     Margin="0,20,0,0">

            <Button Name="ChatButton"
                    Content="💬 Chatbot"
                    Margin="10"
                    FontSize="22"/>

            <Button Name="TaskButton"
                    Content="📝 Task Manager"
                    Margin="10"
                    FontSize="22"/>

            <Button Name="QuizButton"
                    Content="🧠 Cyber Quiz"
                    Margin="10"
                    FontSize="22"/>

            <Button Name="LogButton"
                    Content="📋 Activity Log"
                    Margin="10"
                    FontSize="22"/>

        </UniformGrid>

    </Grid>

</Window>